{
  "name": "logdig",
  "version": "0.2.2",
  "description": "Turn saved Pi sessions into a work journal in your Obsidian daily notes.",
  "license": "MIT",
  "author": "Soleone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soleone/logdig.git"
  },
  "homepage": "https://github.com/Soleone/logdig#readme",
  "bugs": "https://github.com/Soleone/logdig/issues",
  "keywords": [
    "pi-package",
    "pi",
    "obsidian",
    "journal",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "logdig": "./bin/logdig.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "QUICKSTART.md",
    "docs/usage.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "scripts": {
    "test": "node --test",
    "demo": "node scripts/demo.js",
    "demo:capture": "node scripts/capture-demo.js",
    "prepublishOnly": "npm test",
    "release": "release-it",
    "release:dry-run": "npm test && release-it --dry-run"
  },
  "devDependencies": {
    "release-it": "^20.2.1"
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.0"
    }
  }
}
